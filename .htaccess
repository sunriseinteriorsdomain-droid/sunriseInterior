<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 1. 301 Permanent Redirects for Old Indexed Pages (Preserve Google Ranking & Fix 404s)
RewriteRule ^contact-us\.html$ /book_a_quote.html [R=301,L]
RewriteRule ^contact\.html$ /book_a_quote.html [R=301,L]
RewriteRule ^about-us\.html$ /about.html [R=301,L]
RewriteRule ^home-interiors\.html$ /home-interiors-bangalore.html [R=301,L]
RewriteRule ^modular-kitchen\.html$ /modular-kitchen-bangalore.html [R=301,L]
RewriteRule ^modular-wardrobe\.html$ /modular-wardrobe-bangalore.html [R=301,L]
RewriteRule ^living-and-dining\.html$ /living-and-dining-bangalore.html [R=301,L]
RewriteRule ^projects\.html$ /projects_.html [R=301,L]
RewriteRule ^book-a-quote\.html$ /book_a_quote.html [R=301,L]

</IfModule>

# Cache static assets to reduce repeat origin requests.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 5 minutes"
    ExpiresByType text/css "access plus 1 day"
    ExpiresByType application/javascript "access plus 1 day"
    ExpiresByType text/javascript "access plus 1 day"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType video/mp4 "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=300, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(?:css|js)$">
        Header set Cache-Control "public, max-age=300, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.webp$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.mp4$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

# Compress text assets; already-compressed images and videos are excluded.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
